{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Shrinking Gap dataset",
  "type": "object",
  "required": [
    "meta",
    "fields",
    "origins",
    "visionAreas",
    "milestones",
    "founders",
    "events",
    "eras",
    "outlookModel",
    "fx",
    "jokes",
    "defaults"
  ],
  "$defs": {
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "ref": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "status": {
          "enum": [
            "ok",
            "broken",
            "unchecked"
          ]
        },
        "checked": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "revision",
        "asOf",
        "horizonYears",
        "startYear",
        "author",
        "disclaimer"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "asOf": {
          "$ref": "#/$defs/date"
        },
        "horizonYears": {
          "type": "integer",
          "minimum": 5,
          "maximum": 20
        },
        "startYear": {
          "$ref": "#/$defs/year"
        },
        "lastAgentRun": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colour"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "subfields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ]
            }
          }
        }
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colour",
          "z"
        ]
      }
    },
    "visionAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ]
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "field",
          "origin",
          "status",
          "title",
          "research",
          "change",
          "confidence",
          "note",
          "provenance"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "field": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "academic",
              "industry",
              "government"
            ]
          },
          "status": {
            "enum": [
              "landed",
              "outlook",
              "in-lab"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 90
          },
          "research": {
            "type": "object",
            "required": [
              "year",
              "what"
            ],
            "properties": {
              "year": {
                "$ref": "#/$defs/year"
              },
              "what": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "change": {
            "type": "object",
            "required": [
              "year",
              "what"
            ],
            "properties": {
              "year": {
                "$ref": "#/$defs/year"
              },
              "what": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "company": {
            "type": "string",
            "maxLength": 80
          },
          "desnz": {
            "enum": [
              "opt",
              "asset",
              "demand",
              "rd",
              "gov"
            ]
          },
          "flags": {
            "type": "object",
            "properties": {
              "major": {
                "type": "boolean"
              },
              "university": {
                "type": "boolean"
              },
              "aiDriven": {
                "type": "boolean"
              },
              "policy": {
                "type": "boolean"
              },
              "disputed": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "basis": {
            "$ref": "#/$defs/ref"
          },
          "provenance": {
            "type": "object",
            "required": [
              "verification",
              "addedBy",
              "added",
              "lastChecked"
            ],
            "properties": {
              "verification": {
                "enum": [
                  "source-cited",
                  "ai-compiled",
                  "ai-estimate"
                ]
              },
              "addedBy": {
                "enum": [
                  "initial-build",
                  "research-agent",
                  "qa-agent"
                ]
              },
              "added": {
                "$ref": "#/$defs/date"
              },
              "lastChecked": {
                "$ref": "#/$defs/date"
              },
              "approximate": {
                "type": "boolean"
              },
              "qaNote": {
                "type": "string",
                "maxLength": 400
              }
            }
          },
          "adoption": {
            "type": "object",
            "required": [
              "year",
              "what",
              "basis"
            ],
            "properties": {
              "year": {
                "$ref": "#/$defs/year"
              },
              "what": {
                "$ref": "#/$defs/text"
              },
              "basis": {
                "enum": [
                  "ai-estimate",
                  "source-cited"
                ]
              },
              "refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          },
          "region": {
            "enum": [
              "uk",
              "us",
              "europe",
              "asia",
              "other",
              "global",
              "unknown"
            ]
          },
          "tags": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "subfield": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "aiLevers": {
            "type": "object",
            "required": [
              "phase",
              "levers",
              "refs",
              "checked"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "rd",
                  "demo",
                  "build",
                  "approvals",
                  "deploy"
                ]
              },
              "bottleneck": {
                "type": "string"
              },
              "levers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "k",
                    "strength"
                  ],
                  "properties": {
                    "k": {
                      "enum": [
                        "discovery",
                        "simulation",
                        "software",
                        "approvals",
                        "deploy"
                      ]
                    },
                    "strength": {
                      "enum": [
                        "low",
                        "mid",
                        "high"
                      ]
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "label": {
                      "type": "string"
                    },
                    "quote": {
                      "type": "string"
                    }
                  }
                }
              },
              "checked": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "founders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "names",
          "company",
          "field",
          "founded",
          "fortuneYear",
          "how",
          "confidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "founded": {
            "$ref": "#/$defs/year"
          },
          "fortuneYear": {
            "$ref": "#/$defs/year"
          },
          "research": {
            "enum": [
              "university",
              "lab"
            ]
          },
          "netWorth": {
            "type": "object",
            "required": [
              "usdBn",
              "who",
              "basis",
              "asOf"
            ],
            "properties": {
              "usdBn": {
                "type": "number",
                "minimum": 0,
                "maximum": 5000
              },
              "asOf": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "year",
          "category",
          "text"
        ],
        "properties": {
          "year": {
            "$ref": "#/$defs/year"
          },
          "category": {
            "enum": [
              "world",
              "energy",
              "tech",
              "future"
            ]
          }
        }
      }
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "year",
          "name"
        ]
      }
    },
    "jokes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "fx": {
      "type": "object",
      "required": [
        "gbpPerUsd",
        "asOf"
      ]
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ]
      }
    },
    "tagVocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}